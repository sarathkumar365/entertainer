# secrets
.env
*.key

# personal data — this repo is public, never push taste data.
# Anchored with a leading slash: a bare `data/` matches any directory of that
# name at any depth, which silently excluded the whole of
# src/entertainer/data/ — the entire ingest layer — from the repository.
/data/
/profile/

# Exported verdict history. `ent export` writes profile.jsonl to the working
# directory by default, and this repository is public: an export left in place
# would publish the user's entire viewing history on the next `git add -A`.
profile.jsonl
*.profile.jsonl
profile*.jsonl
*.duckdb
*.duckdb.wal
*.parquet
*.npy
*.npz
*.faiss

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# models
/models_cache/
*.safetensors
*.gguf

# encoding shards
*_shards/

# frontend
node_modules/
