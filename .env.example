# Copy to .env and fill in. .env is gitignored — never commit real keys.

# TMDB API read access token (v4 bearer) OR api key (v3).
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BEARER=

# Where the catalogue, embeddings and your profile live.
# Defaults to ./data if unset.
ENTERTAINER_DATA_DIR=

# Private GitHub repository `ent release publish` and `ent pull` use.
# Defaults to sarathkumar365/entertainer-builds if unset. Must be private.
ENTERTAINER_RELEASES_REPO=

# The agent. Telegram user-client credentials from https://my.telegram.org,
# then `ent acquire login` once. Channels (searched) and request groups
# (posted in) are explicit comma-separated allowlists; nothing else is used.
# Groups falls back to channels when unset.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ENTERTAINER_TG_CHANNELS=
ENTERTAINER_TG_GROUPS=
# Optional: where the Telegram session file lives (default <data dir>/telegram/).
ENTERTAINER_TG_SESSION=
# Where acquired films land: the Jellyfin Movies library. No default — a
# machine without it set cannot acquire.
ENTERTAINER_LIBRARY_DIR=
# Optional: off switches acquisition off. Sources, size cap (GB) and disk reserve (GB).
ENTERTAINER_ACQUIRE=
ENTERTAINER_ACQUIRE_SOURCES=telegram-bot,telegram,archive
ENTERTAINER_ACQUIRE_MAX_GB=3
ENTERTAINER_ACQUIRE_RESERVE_GB=5
# Optional: ask Jellyfin to rescan after each acquisition.
JELLYFIN_URL=
JELLYFIN_API_KEY=
