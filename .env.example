# Copy to .env and fill in. .env is gitignored — never commit real keys.

# TMDB API read access token (v4 bearer) OR api key (v3).
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BEARER=

# Where the catalogue, embeddings and your profile live.
# Defaults to ./data if unset.
ENTERTAINER_DATA_DIR=

# Private GitHub repository `ent release publish` and `ent pull` use.
# Defaults to sarathkumar365/entertainer-builds if unset. Must be private.
ENTERTAINER_RELEASES_REPO=
